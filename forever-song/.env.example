# Wajib: API key Claude untuk menulis lirik (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Opsional di lokal, wajib di production (Vercel): penyimpanan lagu.
# Kalau kosong, lagu disimpan di file .data/songs.json (hanya untuk development).
